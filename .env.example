# Node 22+. Public Supabase values: RLS must remain enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only; never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_TEST_MODE=true
SHIPPING_CONTACT_EMAIL=
CRON_SECRET=
# Enable only when your hosting proxy overwrites x-forwarded-for.
TRUST_PROXY_IP=false
